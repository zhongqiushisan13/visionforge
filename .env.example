# ===== VisionForge 环境配置 =====
# 复制为 .env 后填写。只有 DEEPSEEK_API_KEY 是「写剧本」必需的，
# 其余留空也能跑（会降级到本地占位片 / 免费配音）。

# ---------- 编剧大脑：任何 OpenAI 兼容端点 ----------
# auto=有 key 走云，没有但 base_url 是本地就走本地；cloud / local 可强制
DEEPSEEK_MODE=auto
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# 本地示例（Ollama）：
#   DEEPSEEK_MODE=local
#   DEEPSEEK_BASE_URL=http://127.0.0.1:11434/v1
#   DEEPSEEK_MODEL=qwen2.5:14b
# deepseek-reasoner / deepseek-v4-pro 也可以；不可用时会自动回退

# ---------- 镜头生成：云端 / 本地网关 / ComfyUI 工作流 ----------
# auto=有 key 走云；cloud / local / comfyui / mock 可强制
MINIMAX_MODE=auto
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io
# MiniMax-H3 / MiniMax-H3-Highspeed / MiniMax-H3-Lite / MiniMax-H3-Max
MINIMAX_VIDEO_MODEL=MiniMax-H3
MINIMAX_RESOLUTION=768P
MINIMAX_RATIO=16:9
# 本地网关若照 MiniMax v2 协议实现，只改 base_url 即可；路径不同就改这两行
MINIMAX_SUBMIT_PATH=/v2/video_generation
MINIMAX_QUERY_PATH=/v2/query/video_generation/{task_id}
# ComfyUI 视频工作流（放 workflows/ 下），填了就走本地出片
MINIMAX_VIDEO_WORKFLOW=
MINIMAX_VIDEO_TIMEOUT=2400
# 本地关键帧以 base64 内联给 H3；改成 skip 则纯文生视频
MINIMAX_LOCAL_IMAGE_MODE=base64

# ---------- MiniMax 配音（可选；不填走 edge-tts 免费引擎） ----------
MINIMAX_TTS_MODEL=speech-2.8-hd
MINIMAX_VOICE_ID=male-qn-qingse

# ---------- ComfyUI：关键帧 + LoRA ----------
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW=sdxl_txt2img.json
# 留空则用工作流里写死的 checkpoint
COMFYUI_CHECKPOINT=
# 例：tonwin_style_v3.safetensors（会自动插入 LoraLoader 节点）
COMFYUI_LORA=
COMFYUI_LORA_STRENGTH=0.8
COMFYUI_STEPS=28
COMFYUI_CFG=6.5

# ---------- 成片规格 ----------
VF_WIDTH=1920
VF_HEIGHT=1080
VF_FPS=30
VF_SUBTITLE=true
VF_SUBTITLE_FONT=Microsoft YaHei
VF_SUBTITLE_SIZE=54
VF_BGM=
VF_BGM_VOLUME=0.18
VF_TRANSITION=fade
# auto / libx264 / h264_nvenc / h264_qsv / h264_amf（首次启动会自动选）
VF_ENCODER=auto

# ---------- 运行 ----------
# 想零成本验证链路就打开：全部用占位素材，不碰付费接口
VF_MOCK=0
VF_WORKERS=3
VF_PROJECTS_DIR=projects
# 单项目付费调用预算上限（元，估算值；0=不限）
VF_BUDGET=0
# 单次调用估算价，JSON；默认 {"deepseek":0.05,"minimax_video":3.0,"minimax_tts":0.1}
# VF_PRICES={"deepseek":0.05,"minimax_video":3.0,"minimax_tts":0.1}
# 自定义 ffmpeg 路径（默认用 PATH 或 imageio-ffmpeg 内置）
# VF_FFMPEG=C:\ffmpeg\bin\ffmpeg.exe
# 仅供自动化测试：关闭本地 API 的 token/Host 防护（正常使用时不要开）
# VF_ALLOW_UNSAFE_API=0
