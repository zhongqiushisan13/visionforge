# VisionForge × MiniMax H3（本地 ComfyUI 通道）
# 用法：把本文件内容复制到用户目录的 .env
#   Windows: %APPDATA%\VisionForge\.env
#   macOS/Linux: ~/.config/visionforge/.env
# 老版本放在项目根目录的 .env 仍兼容；改完需重启应用。

# ── 镜头来源：走 ComfyUI 视频工作流 ───────────────────────────
MINIMAX_MODE=comfyui
MINIMAX_VIDEO_WORKFLOW=minimax_h3_gguf_i2v.json
# 本地 8GB 显卡 5 秒镜头约 5 分钟，别按云端的 2400s 算
MINIMAX_VIDEO_TIMEOUT=5400

# ── ComfyUI 服务 ────────────────────────────────────────────
COMFYUI_BASE_URL=http://127.0.0.1:8188

# H3 的工作分辨率（必须 32 的倍数；608x352 ≈ 0.2MP，8GB 显存的安全档）
# 只作用于视频工作流，关键帧出图仍看 COMFYUI_WIDTH / COMFYUI_HEIGHT
MINIMAX_VIDEO_WIDTH=608
MINIMAX_VIDEO_HEIGHT=352
# H3 是 4 步 turbo LoRA，别套 SD 的 28 步
MINIMAX_VIDEO_STEPS=4

# 首帧以 base64 内联给 H3；写 skip 则纯文生视频（自动摘掉首帧连线）
MINIMAX_LOCAL_IMAGE_MODE=base64

# ── 关键帧出图（没有 checkpoint 时自动退回本地占位图）──────────
COMFYUI_WORKFLOW=sdxl_txt2img.json
COMFYUI_WIDTH=1024
COMFYUI_HEIGHT=576
COMFYUI_STEPS=28

# ── 成片规格 ────────────────────────────────────────────────
# H3 原生 24fps，成片也按 24fps 出，避免帧率换算导致镜头长度漂移
VF_FPS=24
VF_WIDTH=608
VF_HEIGHT=352
VF_SUBTITLE_SIZE=28
VF_WORKERS=1
VF_RETRIES=1

# ── 剧本：无 Key 时用内置示例分镜（真实 Key 请填 DEEPSEEK_API_KEY）──
# DEEPSEEK_MODE=cloud
# DEEPSEEK_API_KEY=sk-xxxx
# DEEPSEEK_MODEL=deepseek-v4-flash
