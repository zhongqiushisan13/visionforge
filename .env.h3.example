# VisionForge × MiniMax H3（本地 ComfyUI 通道）
# 用法：把本文件内容复制到用户目录的 .env
#   Windows: %APPDATA%\VisionForge\.env
#   macOS/Linux: ~/.config/visionforge/.env
# 老版本放在项目根目录的 .env 仍兼容；改完需重启应用。

# ── 镜头来源：走 ComfyUI 视频工作流 ───────────────────────────
MINIMAX_MODE=comfyui
MINIMAX_VIDEO_WORKFLOW=minimax_h3_gguf_i2v.json
MINIMAX_VIDEO_TIMEOUT=5400

# ── ComfyUI 服务 ────────────────────────────────────────────
COMFYUI_BASE_URL=http://127.0.0.1:8188

# H3 的工作分辨率（必须 32 的倍数；608x352 ≈ 0.2MP，8GB 显存的安全档）
COMFYUI_WIDTH=608
COMFYUI_HEIGHT=352
COMFYUI_STEPS=4

# ── 成片规格 ────────────────────────────────────────────────
# H3 原生 24fps，成片也按 24fps 出，避免帧率换算导致镜头长度漂移
VF_FPS=24
VF_WIDTH=608
VF_HEIGHT=352
VF_WORKERS=1
VF_RETRIES=1

# ── 剧本：无 Key 时用内置示例分镜（真实 Key 请填 DEEPSEEK_API_KEY）──
# DEEPSEEK_MODE=cloud
# DEEPSEEK_API_KEY=sk-xxxx
# DEEPSEEK_MODEL=deepseek-v4-flash

# ── 关键帧：先不接 ComfyUI 出图，用本地占位图 ──────────────────
# （等 H3 跑通再把关键帧也切到 ComfyUI，见手册第 3 篇）
